# Copier en .env (jamais commité).

# --- Développement (docker-compose.yml) : ports de l'hôte, à changer si un autre projet les occupe déjà.
APP_PORT=3000
MAIL_PORT=8025
DB_PORT=5432

# --- Production (docker-compose.prod.yml) : rempli sur le serveur, recopié par la CI pour les secrets.
# Image publiée par la CI, ex. ghcr.io/<compte>/<dépôt>.
IMAGE=
# Domaine servi en HTTPS par le reverse proxy, qui renvoie vers 127.0.0.1:APP_PORT.
DOMAIN=
# Générer avec : openssl rand -hex 24
POSTGRES_PASSWORD=
# Clé API Brevo (emails transactionnels) et expéditeur validé dans Brevo.
BREVO_API_KEY=
MAIL_FROM=
